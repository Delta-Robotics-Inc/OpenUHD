// Direction D2 in KCL: the motor face as its own artifact — only the mating
// face (a 0.25 mm pad over the base annulus, minus the four tapped holes),
// in the motor's coordinates. Exported on its own, it is what a viewer
// highlights and what `zoo kcl surface-area` / `center-of-mass` fingerprint.
@settings(defaultLengthUnit = mm)

import motorDiameter, motorBaseBoltCircle from "params.kcl"

pad = startSketchOn(offsetPlane(XY, offset = -0.25))
  |> circle(center = [0, 0], radius = motorDiameter / 2 - 0.65)
  |> extrude(length = 0.25)

holes = startSketchOn(offsetPlane(XY, offset = -0.25))
  |> circle(
       center = [
         motorBaseBoltCircle / 2 * cos(45deg),
         motorBaseBoltCircle / 2 * sin(45deg)
       ],
       radius = 1.25,
     )
  |> extrude(length = 0.25)
  |> patternCircular3d(
       instances = 4,
       axis = Z,
       center = [0, 0, 0],
       arcDegrees = 360deg,
       rotateDuplicates = false,
     )

baseMount = subtract([pad], tools = holes)
