// MEPS NEON 2207 V2 — representative body, generated parameters from UHD.
// Direction D1 in KCL: the motor face is the extrude's start cap, tagged
// $baseMount. UHD refers to it as { kind: "feature", artifact: "cad_kcl",
// name: "baseMount" }; the tag is resolved by running this file.
@settings(defaultLengthUnit = mm)

import motorDiameter, motorBodyHeight, motorOverallHeight, motorShaftDiameter, motorBaseBoltCircle from "params.kcl"

baseHeight = 3
tapDrill = 2.5

base = startSketchOn(XY)
  |> circle(center = [0, 0], radius = motorDiameter / 2 - 0.65)
  |> extrude(length = baseHeight, tagStart = $baseMount)

// four M3 tapped holes on the bolt circle, at 45° like the drawing
hole = startSketchOn(XY)
  |> circle(
       center = [
         motorBaseBoltCircle / 2 * cos(45deg),
         motorBaseBoltCircle / 2 * sin(45deg)
       ],
       radius = tapDrill / 2,
     )
  |> extrude(length = baseHeight)
  |> patternCircular3d(
       instances = 4,
       axis = Z,
       center = [0, 0, 0],
       arcDegrees = 360deg,
       rotateDuplicates = false,
     )

mountedBase = subtract([base], tools = hole)

bell = startSketchOn(offsetPlane(XY, offset = baseHeight))
  |> circle(center = [0, 0], radius = motorDiameter / 2)
  |> extrude(length = motorBodyHeight - baseHeight)

shaft = startSketchOn(offsetPlane(XY, offset = motorBodyHeight))
  |> circle(center = [0, 0], radius = motorShaftDiameter / 2)
  |> extrude(length = motorOverallHeight - motorBodyHeight, tagEnd = $shaftTip)
