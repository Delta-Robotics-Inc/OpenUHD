{
  "name": "@deltarobotics/uhd",
  "version": "0.2.0",
  "description": "Universal Hardware Description — an open, composable description language for multidisciplinary hardware engineering. Module / Interface / Harness primitives.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./drc": {
      "types": "./dist/drc/index.d.ts",
      "import": "./dist/drc/index.js"
    },
    "./taxonomy": {
      "types": "./dist/taxonomy/index.d.ts",
      "import": "./dist/taxonomy/index.js"
    },
    "./taxonomy/uhd-taxonomy.json": "./src/taxonomy/uhd-taxonomy.json",
    "./taxonomy/uhd-taxonomy.schema.json": "./src/taxonomy/uhd-taxonomy.schema.json",
    "./taxonomy/taxonomy-extension.schema.json": "./src/taxonomy/taxonomy-extension.schema.json",
    "./library": {
      "types": "./dist/library/index.d.ts",
      "import": "./dist/library/index.js"
    },
    "./schemas/uhd-library-v1.schema.json": "./schemas/uhd-library-v1.schema.json"
  },
  "files": [
    "dist",
    "src",
    "schemas",
    "skills",
    "docs/**/*.md",
    "!docs/PR-*.md",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:library": "node -e \"console.log('UHD has no part library: parts come from libraries served over the open library protocol (docs/library-protocol.md).')\"",
    "build:taxonomy": "tsx scripts/build-taxonomy.ts",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "build:schemas": "tsx scripts/write-schemas.ts"
  },
  "keywords": [
    "hardware",
    "hardware-description",
    "uhd",
    "electronics",
    "mechanical",
    "pneumatic",
    "robotics",
    "eda",
    "schematic",
    "interchange",
    "open-standard",
    "taxonomy"
  ],
  "author": "Delta Robotics, Inc.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Delta-Robotics-Inc/uhd.git"
  },
  "bugs": {
    "url": "https://github.com/Delta-Robotics-Inc/uhd/issues"
  },
  "homepage": "https://github.com/Delta-Robotics-Inc/uhd#readme",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  }
}
