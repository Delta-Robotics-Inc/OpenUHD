{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uhd-test-data/1",
  "title": "UHD document test data",
  "description": "One test per file: <system>/docs/test-data/<id>.json. status standin = derived from the model (watermarked); measured = real results.",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "subject",
    "conditions",
    "provenance",
    "columns",
    "rows",
    "summary"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Equals the file name without .json"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "standin",
        "measured"
      ]
    },
    "subject": {
      "type": "object",
      "required": [
        "system"
      ],
      "properties": {
        "system": {
          "type": "string"
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value",
          "unit"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "string"
            ]
          },
          "unit": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "derivedFrom": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Value queries (scripts/docs/lib/values.ts) a stand-in was derived from"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generator": {
          "type": "string"
        },
        "generatedAt": {
          "type": "string"
        },
        "operator": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "description": "Measured data: ISO date of the test"
        },
        "instruments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rawFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "unit"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": [
            "number",
            "string"
          ]
        }
      }
    },
    "summary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "value",
          "unit"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "string"
            ]
          },
          "unit": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "measured"
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "required": [
              "method",
              "date"
            ]
          }
        }
      }
    }
  ]
}
